{
  "feature": "category API with reviews",
  "entities": [
    {
      "name": "Category",
      "action": "create",
      "module": "models.py",
      "attributes": [
        {"name": "id", "type": "int", "required": true, "primary_key": true},
        {"name": "name", "type": "str", "required": true, "max_length": 255},
        {"name": "created_at", "type": "datetime", "required": true, "default": "now"},
        {"name": "updated_at", "type": "datetime", "required": true, "default": "now", "on_update": "now"}
      ],
      "invariants": [
        "name must be non-empty and unique",
        "deleting a category cascades to its reviews"
      ]
    },
    {
      "name": "Review",
      "action": "create",
      "module": "models.py",
      "attributes": [
        {"name": "id", "type": "int", "required": true, "primary_key": true},
        {"name": "category_id", "type": "int", "required": true, "foreign_key": "categories.id"},
        {"name": "name", "type": "str", "required": true, "max_length": 255},
        {"name": "created_at", "type": "datetime", "required": true, "default": "now"},
        {"name": "updated_at", "type": "datetime", "required": true, "default": "now", "on_update": "now"}
      ],
      "invariants": [
        "review must reference an existing category via category_id",
        "review cannot exist orphaned (category_id is NOT NULL)"
      ]
    }
  ],
  "relationships": [
    {
      "from": "Category",
      "to": "Review",
      "kind": "has_many",
      "foreign_key": "category_id",
      "back_populates": "category",
      "cascade": "all, delete-orphan"
    },
    {
      "from": "Review",
      "to": "Category",
      "kind": "belongs_to",
      "foreign_key": "category_id",
      "back_populates": "reviews"
    }
  ],
  "api_surface": [
    {"method": "POST",   "path": "/api/v1/categories",                    "handler": "create_category",    "request_schema": "CategoryCreate", "response_schema": "CategoryRead", "status": 201},
    {"method": "GET",    "path": "/api/v1/categories",                    "handler": "list_categories",    "response_schema": "list[CategoryRead]", "status": 200},
    {"method": "GET",    "path": "/api/v1/categories/{category_id}",      "handler": "get_category",       "response_schema": "CategoryRead", "status": 200},
    {"method": "PATCH",  "path": "/api/v1/categories/{category_id}",      "handler": "update_category",    "request_schema": "CategoryUpdate", "response_schema": "CategoryRead", "status": 200},
    {"method": "DELETE", "path": "/api/v1/categories/{category_id}",      "handler": "delete_category",    "status": 204},
    {"method": "POST",   "path": "/api/v1/categories/{category_id}/reviews", "handler": "create_review",   "request_schema": "ReviewCreate", "response_schema": "ReviewRead", "status": 201},
    {"method": "GET",    "path": "/api/v1/categories/{category_id}/reviews", "handler": "list_reviews",    "response_schema": "list[ReviewRead]", "status": 200},
    {"method": "GET",    "path": "/api/v1/reviews/{review_id}",           "handler": "get_review",         "response_schema": "ReviewRead", "status": 200},
    {"method": "DELETE", "path": "/api/v1/reviews/{review_id}",           "handler": "delete_review",      "status": 204}
  ],
  "schemas": [
    {"name": "CategoryCreate", "module": "schemas.py", "fields": ["name"]},
    {"name": "CategoryUpdate", "module": "schemas.py", "fields": ["name?"]},
    {"name": "CategoryRead",   "module": "schemas.py", "fields": ["id", "name", "created_at", "updated_at"]},
    {"name": "ReviewCreate",   "module": "schemas.py", "fields": ["name"]},
    {"name": "ReviewRead",     "module": "schemas.py", "fields": ["id", "category_id", "name", "created_at", "updated_at"]}
  ],
  "files": {
    "models.py":   {"action": "extend", "adds": ["Category", "Review"], "reuses": ["Base"]},
    "schemas.py":  {"action": "create", "adds": ["CategoryCreate", "CategoryUpdate", "CategoryRead", "ReviewCreate", "ReviewRead"]},
    "routers/categories.py": {"action": "create", "adds": ["router (category endpoints + nested reviews)"]},
    "routers/reviews.py":    {"action": "create", "adds": ["router (review-by-id endpoints)"]},
    "main.py":     {"action": "edit", "adds": ["include_router(categories.router)", "include_router(reviews.router)"]},
    "tests/test_categories.py": {"action": "create"},
    "tests/test_reviews.py":    {"action": "create"}
  },
  "test_contract": {
    "auth": "none",
    "pagination": "list",
    "error_shape": "fastapi_httpexception",
    "content_type": "application/json",
    "framework": "pytest + fastapi.testclient",
    "fixtures": ["db_session", "client"],
    "rationale": "Existing codebase (fastapi-shop) has no auth middleware and Product endpoints return plain lists; matching that convention keeps the new endpoints consistent with existing handlers."
  },
  "conventions": {
    "language": "python",
    "framework": "fastapi",
    "orm": "sqlalchemy",
    "schema_lib": "pydantic_v2",
    "naming": "snake_case",
    "model_base": "Base from models"
  },
  "wiring": {
    "main_py": [
      "from routers import categories as categories_router",
      "from routers import reviews as reviews_router",
      "app.include_router(categories_router.router)",
      "app.include_router(reviews_router.router)"
    ],
    "migrations": [
      "alembic_revision: create_categories_table",
      "alembic_revision: create_reviews_table (with category_id FK + index)"
    ],
    "table_create": "Base.metadata.create_all(bind=engine) covers new tables if alembic is absent"
  },
  "non_goals": [
    "no rating/score field on Review (domain model did not extract one)",
    "no auth/permissions (matches existing codebase contract)",
    "no full-text search on categories"
  ],
  "open_questions": [
    {"id": "q1", "confidence": 0.65, "question": "Review currently has only a 'name' attribute from the domain extractor. Should it also carry a body/text and rating? Spec stays minimal until clarified."},
    {"id": "q2", "confidence": 0.7,  "question": "Should DELETE /categories/{id} cascade-delete reviews (current spec) or 409 if reviews exist?"}
  ]
}
