  "services": [
    {
      "name": "CardService",
      "module": "kanban/services/card_service.py",
      "operations": [
        {
          "name": "move_card",
          "signature": "move_card(card_id, target_column_id, target_position, moved_by) -> Card",
          "transactional": true,
          "steps": [
            "lock source column rows (SELECT ... FOR UPDATE on cards where column_id = source)",
            "lock destination column rows",
            "renumber source: decrement position for rows where position > old_position",
            "renumber destination: increment position for rows where position >= target_position",
            "update card.column_id and card.position",
            "emit card.moved event"
          ]
        }
      ]
    }
